<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DeviceLogic unit tests -->
    <Compile Include="DeviceLogic\InitialStateTests.fs" />
    <Compile Include="DeviceLogic\SelectionTests.fs" />
    <Compile Include="DeviceLogic\RequestTests.fs" />
    <Compile Include="DeviceLogic\UnknownFrameTests.fs" />
    <Compile Include="DeviceLogic\PreservationTests.fs" />
    
    <!-- DeviceSelection unit tests -->
    <Compile Include="DeviceSelectionTests.fs" />
    
    <!-- DeviceRuntime integration tests -->
    <Compile Include="DeviceRuntimeTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <PackageReference Include="FsUnit.Xunit" Version="7.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devices\Devices.fsproj" />
  </ItemGroup>

</Project>
