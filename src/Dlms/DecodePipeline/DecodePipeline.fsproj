<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Metering.Dlms.DecodePipeline</AssemblyName>
        <RootNamespace>Metering.Dlms.Protocol</RootNamespace>
    </PropertyGroup>

    <!--
      Architecture pilot: compile only the migrated vertical slice while the
      remaining legacy DLMS project still depends on the former core.
    -->
