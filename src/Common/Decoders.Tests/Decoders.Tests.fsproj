<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <RootNamespace>Metering.Common.Decoding.Decoders.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestSupport.fs" />
        <Compile Include="CoreDecoderTests.fs" />
        <Compile Include="InMemorySourceStoreTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit.v3" Version="3.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
        <PackageReference Include="FsUnit.Xunit" Version="7.1.1" />
        <PackageReference Include="coverlet.collector" Version="6.0.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ByteReaders\ByteReaders.csproj" />
        <ProjectReference Include="..\Decoders\Decoders.fsproj" />
        <ProjectReference Include="..\Parsers\Parsers.fsproj" />
        <ProjectReference Include="..\Validators\Validators.fsproj" />
    </ItemGroup>

</Project>
