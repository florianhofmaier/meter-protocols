root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{fs,fsi,fsx}]
indent_size = 4
max_line_length = 100
fsharp_multiline_bracket_style = stroustrup

[*.cs]
indent_size = 4
max_line_length = 100
csharp_new_line_before_open_brace = all

[*.{ts,tsx,js,jsx,css,html,json,yml,yaml}]
indent_size = 2
max_line_length = 100

[*.{fsproj,csproj,props,targets}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
